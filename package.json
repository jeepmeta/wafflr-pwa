{
  "name": "wafflr",
  "private": true,
  "version": "0.6.0",
  "description": "Wafflr monorepo — web PWA, Expo native, shared core",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@wafflr/web",
    "dev:web": "turbo run dev --filter=@wafflr/web",
    "dev:native": "turbo run start --filter=@wafflr/native",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "npm run dev -w @wafflr/web"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
